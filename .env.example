# AvaloniaUI.MCP Environment Configuration

# Optional: Sentry DSN for error tracking
# If not set, Sentry integration will be disabled
# SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/123456

# Optional: Environment name (development, staging, production)
# ENVIRONMENT=development

# Optional: Log level (Trace, Debug, Information, Warning, Error, Critical)
# AVALONIA_MCP_LOG_LEVEL=Information
